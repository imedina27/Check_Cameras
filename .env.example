# ============================================
# Plantilla de configuración (.env)
# ============================================
# Copia este archivo como ".env" en la raíz del proyecto y ajusta los
# valores según el entorno donde vayas a correr el programa (ver
# "Los dos entornos de ejecución" en el README.md).
#
# Este archivo (.env.example) SÍ se sube al repositorio, como plantilla.
# Tu copia real (.env) NUNCA se sube — está en .gitignore porque
# normalmente va a tener datos de red internos.

# ============================================
# Nombre del LocalHost
# ============================================
# Debe coincidir con el nombre real de esta máquina (hostname). Se usa
# para detectar si el servidor que se está revisando es "este mismo
# servidor" (caso especial: no necesita proxy ni túnel).
LOCAL_HOST=NOMBRE_DE_ESTA_MAQUINA

# ============================================
# DIRECTORIOS
# ============================================
# Prefijo común de resultados. El programa descubre automáticamente cada
# archivo de cliente en conf/plants/*.yaml (uno por archivo, ver
# conf/plants/plants.yaml.example) y guarda sus resultados en
# RESULT_PATH/<client_id>/... — <client_id> sale del nombre del archivo
# (ej. Api_Manzanillo.yaml -> RESULT_PATH/Api_Manzanillo/). Se crea solo si
# no existe.
RESULT_PATH=./results

# ============================================
# CONFIGURACIÓN DE PING
# ============================================
MAX_PING_ATTEMPTS=3
PING_TIMEOUT=2
RETRY_DELAY=1

# ============================================
# CONFIGURACION CAMARAS PORT 80
# ============================================
MAX_CAMERA_RETRIES=2
CAMERA_PORT_TIMEOUT=3
PORT80_DELAY=1

# ============================================
# CONFIGURACION CAMARAS IA IMAGES
# ============================================
MAX_AI_RETRIES=2
AI_IMAGE_TIMEOUT=3

# Espera entre reintentos al pedir una imagen (IA o directa de la cámara).
# Mitiga fallas transitorias de conexion bajo concurrencia, mismo enfoque
# que ya usa MAX_CONFIG_RETRIES/CONFIG_RETRY_DELAY.
IMAGE_RETRY_DELAY=1

# ============================================
# DESCARGA DE CONFIGURACION
# ============================================
CONF_TIMEOUT=3

# Reintentos al descargar la configuracion de una camara (Cam_Config).
# Mitiga fallas transitorias de conexion bajo concurrencia (ej. RemoteDisconnected
# en Hikvision, confirmado en produccion: mucho mas frecuente al revisar camaras
# en paralelo que de forma secuencial).
MAX_CONFIG_RETRIES=2
CONFIG_RETRY_DELAY=1

# ============================================
# TIMEOUTS YAML
# ============================================
YAML_TIMEOUT=3

# ============================================
# LOCAL PORTS TUNNELS
# ============================================
# Solo se usan si algún servidor en tu plants.yaml tiene "type: tunnels".
# En Windows, usa una ruta de archivo válida en Windows para los PID
# (ej. una carpeta temporal); en Ubuntu, una ruta Unix como /tmp/...
IA_LOC_PORT=9045
PX_LOC_PORT=39533
IA_PID_FILE=/tmp/ssh_ia_tunnel.pid
PX_PID_FILE=/tmp/ssh_px_tunnel.pid

# ============================================
# RETRIES FOR CLOSE TUNNELS
# ============================================
MAX_RETRIES=2

# ============================================
# TIEMPO DE PROCESO POR CAMARA (visibilidad en el log, verde/amarillo)
# ============================================
# Segundos que se considera "normal" que tarde el proceso completo de
# una cámara (puerto 80 + imagen IA + imagen + configuración). Si lo
# excede, se loguea en amarillo (no se cancela nada, es solo un aviso).
# Ajusta este valor viendo tus propios logs reales.
CAM_TIME_THRESHOLD=15

# ============================================
# PARALELIZACION DE CAMARAS POR SERVIDOR
# ============================================
# Cuántas cámaras de un mismo servidor se revisan al mismo tiempo.
MAX_CAMERA_WORKERS=5

# ============================================
# ORDEN DEL RESUMEN
# ============================================
# Estrategia de orden por nombre de servidor para el resumen (ver
# sort_strategies.py). 'numeric_suffix' ordena por el número al final del
# nombre del servidor (QLYMSPROD01, QLYMSPROD02...), sin importar el prefijo
# ni la planta. 'alphabetical' ordena alfabéticamente por el nombre completo
# — es la opción segura por defecto, no depende de ninguna convención de
# nombres. Para agregar una estrategia nueva (ej. un cliente nuevo con su
# propia convención), se agrega la función en sort_strategies.py — no hace
# falta tocar nada más del código.
LOG_SORT_STRATEGY=alphabetical
